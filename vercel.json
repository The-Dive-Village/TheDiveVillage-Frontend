{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/hydrate-lfs-assets.js && node scripts/verify-lfs-assets.js && npm run build --workspace=Frontend",
  "outputDirectory": "Frontend/dist",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Accept-Ranges": "bytes",
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/media/(.*)",
      "dest": "https://pub-4163c0b42ded4a0a9b4f34a1460da643.r2.dev/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Accept-Ranges": "bytes",
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
